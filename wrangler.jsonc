// Workers Builds config: the Next.js static export (`npm run build` → ./out)
// served as Worker assets — the same setup as mockifyr/specdrift/mediant.qorpe.com.
{
  "name": "qorpe-com",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
